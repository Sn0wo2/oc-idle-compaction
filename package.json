{
  "name": "oc-idle-compaction",
  "version": "0.0.0",
  "description": "OpenCode2 plugin that compacts large idle sessions before their prompt cache expires.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sn0wo2/oc-idle-compaction.git"
  },
  "packageManager": "bun@1.4.4",
  "files": [
    "src"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check --error-on-warnings .",
    "lint:fix": "biome check --write --error-on-warnings .",
    "check": "tsc --noEmit",
    "test": "bun test",
    "security": "bun audit --registry=https://registry.npmjs.org",
    "ci": "bun run lint && bun run check && bun run test && bun run security"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode2",
    "opencode2-plugin",
    "plugin",
    "compaction",
    "prompt-cache",
    "coding-agent",
    "ai"
  ],
  "author": "Me0wo",
  "contributors": [
    "vimtor"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@opencode/plugin": "^2.0.32",
    "es-toolkit": "^1.52.0",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
